{
  "expo": {
    "name": "Daybook",
    "slug": "daybook",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "scheme": "daybook",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FAF8F4"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.daybook.app",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Daybook uses Face ID to protect your private data.",
        "NSPhotoLibraryUsageDescription": "Daybook needs access to your photos to attach images to notes and products.",
        "NSCameraUsageDescription": "Daybook uses your camera to capture product images and documents.",
        "NSMicrophoneUsageDescription": "Daybook uses the microphone for voice notes."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "backgroundColor": "#FAF8F4"
      },
      "package": "com.daybook.app"
    },
    "plugins": [
      "expo-router",
      "expo-splash-screen",
      "expo-sqlite",
      "expo-secure-store",
      "expo-font",
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
